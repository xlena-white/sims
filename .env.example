# Copy this file to .env.local and fill in the values from
# Supabase Dashboard → Project Settings → API (or "Connect" → App Frameworks → Next.js).
# Either the new publishable key (sb_publishable_…) or the legacy "anon" key works.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
